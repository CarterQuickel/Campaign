<!DOCTYPE html>
<html lang="en" data-theme="default" data-mode="default">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Charma</title>
    <link rel="icon" href="/icons/dndLogoPlaceholder.png">
    <link rel="stylesheet" href="/index.css">
    <link rel="stylesheet" href="/mastery.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&display=swap" rel="stylesheet">
</head>
<body>
    <div id="banner">
        <div id="leftBan">
            <div id="title">
                <img src="/icons/CharmaLogo.png" width="200" height="200" class="logo">
            </div>
        </div>
        <div id="rightBan">
            <button class="settingsBtn" type="button" onclick="viewSettings(false)" style="margin-right: 10px;">
                SETTINGS
            </button>
            <div class="horiz mobileHidden"></div>
            <div class="statCont">
                <div class="stat">
                    <div class="statType">LVL</div>
                    <div class="statNum"><%= level %></div>
                </div>
                <div class="stat">
                    <div class="statType">PROF</div>
                    <div class="statNum">+2</div>
                </div>
                <div class="stat">
                    <div class="statType">AC</div>
                    <div class="statNum"><%= Math.floor((stats[1] - 10) / 2) + 10 %></div>
                </div>
            </div>
            <div class="horiz"></div>
            <% const statLabels = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA']; %>
            <div class="statCont">
                <% statLabels.forEach((label, index) => { %>
                    <div class="stat">
                        <div class="statType"><%= label %></div>
                        <div class="statNum"><%= stats[index] %></div>
                        <div class="statMod">
                            <% const mod = Math.floor((stats[index] - 10) / 2); %>
                            <%= mod >= 0 ? '+' : '' %><%= mod %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <div class="horiz"></div>
            <div class="stat">
                <div class="statType">HP</div>
                <div class="statNum"><%= charData.HP %>/<%= charData.HP %></div>
            </div>
            <div class="horiz mobileHidden"></div>
            <div class="status">
                <div class="dot <%= online ? 'online' : 'offline' %>"></div>
                <% if (online) { %>
                    <h5 class="on">AI Online</h5>
                <% } else { %>
                    <h5 class="off">AI Offline</h5>
                <% } %>
            </div>
        </div>
    </div>
    <div id="SuperCont">
        <div id="inventoryCont">
            <div class="contBan">
                <div class="header">INVENTORY</div>
                <div class="gold" id="goldDisplay" data-gold="<%= gold %>">◈ <%= gold %>gp</div>
            </div>
            <div class="encumCont" id="encumCont" data-current-weight="0">
                <div class="contBan">
                    <div class="label">Encumbrance</div>
                    <div class="weight" id="weightTxt">50/100 lb</div>
                </div>
                <progress class="encumBar" id="encumbar" value="50" max="100"></progress>
            </div>
            <div class="categoryCont">
                <button class="cate active" data-category='all'>
                    All
                </button>
                <button class="cate" data-category='Weapon'>
                    Weapon
                </button>
                <button class="cate" data-category='Armor'>
                    Armor
                </button>
                <button class="cate" data-category='Potion'>
                    Potion
                </button>
                <button class="cate" data-category='Spell'>
                    Spell
                </button>
                <button class="cate" data-category='Misc'>
                    Misc
                </button>
            </div>
            <div class="toolsContainer">
                <% tools.forEach(tool => { %>
                    <div class="tool <%= tool.unlocked ? '' : 'locked' %> <%= tool.class.toLowerCase() %>" data-name="<%= tool.name %>" data-class="<%= tool.class %>" data-unlocked="<%= tool.unlocked %>" data-weight="<%= tool.weight %>">
                        <div class="left-tool">
                            <div class="tool-icon <%= tool.class.toLowerCase() %>">
                                <%= tool.class === 'Weapon' ? '⚔️' : tool.class === 'Armor' ? '🛡️' : tool.class === 'Potion' ? '🧪' : tool.class === 'Spell' ? '🔮' : '💎' %>
                            </div>
                            <div class="tool-cont">
                                <div class="tool-name"><%= tool.name %></div>
                                <div class="tool-weight" style="display: <%= tool.weight > 0 ? 'flex' : 'none' %>">
                                    <%= tool.weight %> lb
                                </div>
                            </div>
                        </div>
                        <button class="tool-equip-btn">
                            Equip
                        </button>
                    </div>
                <% }); %>
            </div>
        </div>
        <div class="centerCont">
            <div class="response-area">
                <div class="settings" id="settings" style="display: none;">
                    <button class="close" onclick="viewSettings(true)">Close</button>
                    <div class="settingsSidePanel">
                        <div class="header">SETTINGS</div>
                        <div class="settingsList">
                            <button class="setting" data-setting="appearance"><div class="emoji">🖌️</div><div>Appearance</div></button>
                            <button class="setting" data-setting="campaign"><div class="emoji">🔔</div><div>Notifications</div></button>
                            <button class="setting" data-setting="character"><div class="emoji">🙋</div><div>Character Sheet</div></button>
                            <button class="setting" data-setting="ai"><div class="emoji">🤖</div><div>Charma AI</div></button>
                            <button class="setting active" data-setting="data"><div class="emoji">💿</div><div>Data</div></button>
                        </div>
                    </div>
                    <div class="settingsCont">
                        <div class="settingCate disabled" data-setting="appearance">
                            <div class="header">Color Accent</div>
                            <div class="accentCont">
                                <button class="theme" type="button" onclick="changeTheme(`default`)">
                                    PURPLE
                                </button>
                                <button class="theme" type="button" onclick="changeTheme(`red`)">
                                    RED
                                </button>
                                <button class="theme" type="button" onclick="changeTheme(`green`)">
                                    GREEN
                                </button>
                                <button class="theme" type="button" onclick="changeTheme(`blue`)">
                                    BLUE
                                </button>
                            </div>
                            <div class="header">LAYOUT</div>
                            <div class="toggleCont panels">
                                <div class="desc">
                                    <div class="name">Hide Side Panels</div>
                                    <div class="info">Temporarily hide inventory and course</div>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" onclick = "hidePanels()">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                            <div class="toggleCont">
                                <div class="desc">
                                    <div class="name">Light Mode</div>
                                    <div class="info">Blind your eyes for a more retro feel</div>
                                </div>
                                <label class="switch">
                                    <input type="checkbox" onclick="changeMode()">
                                    <span class="slider round"></span>
                                </label>
                            </div>
                        </div>
                        <div class="settingCate disabled" data-setting="campaign">
                            <div class="header">Notifications</div>
                        </div>
                        <form class="settingCate disabled" action="/updateSheet" data-setting="character" method="POST" autocomplete="off">
                            <div class="header">Origin</div>
                            <textarea name="origin" class="origin" id="origin"><%= charData.origin %></textarea>
                            <div class="header" style="margin-bottom: 10px;">Character</div>
                            <div class="textareaCont">
                                <div class="textTitle">Character Name</div>
                                <textarea name="name" class="cName"><%= charData.name %></textarea>
                            </div>
                            <div class="textareaCont">
                                <div class="textTitle">Class</div>
                                <textarea name="class" class="class"><%= charData.class %></textarea>
                            </div>
                            <div class="textareaCont">
                                <div class="textTitle">Race</div>
                                <textarea name="race" class="race"><%= charData.race %></textarea>
                            </div>
                            <button class="saveBtn">Save</button>
                        </form>
                        <div class="settingCate disabled" data-setting="ai">
                            <div class="header">Charma Personality</div>
                        </div>
                        <div class="settingCate enabled" data-setting="data">
                            <div class="header">Danger Zone</div>
                            <button class="new-conversation" type="button" onclick="window.location.href='/'" style="margin-right: 10px;">
                                RESTART CAMPAIGN
                            </button>
                        </div>
                    </div>
                </div>
                <div class="response-box" id="chat">
                    <div id="text-scroll" class="chat-container">
                        <% if (typeof messages !== 'undefined' && messages && messages.length) { %>
                            <% let omitLastAssistant = false; %>
                            <% if (response && messages[messages.length - 1] && messages[messages.length - 1].role === 'assistant' && messages[messages.length - 1].content === response) { omitLastAssistant = true; } %>
                            <% for (let i = 0; i < messages.length; i++) { %>
                                <% if (omitLastAssistant && i === messages.length - 1) { continue; } %>
                                <% const msg = messages[i]; %>
                                <div class="message <%= msg.role === 'user' ? 'user' : 'assistant' %>"><div class="bubble"><%= msg.content %></div></div>
                            <% } %>
                        <% } %>
                    </div>
                    <% if (response) { %>
                        <div id="ai-response" hidden><%= response %></div>
                    <% } %>
                    <div class="chat-form">
                        <!-- Form links directly to the /ask route in app.js -->
                        <form action="/ask" method="POST" onsubmit="showLoading()" id="txtform">
                            <div class="userTypeCont">
                                <div class="preCont">
                                    <button class="preResponse">Where am I?</button>
                                    <button class="preResponse">What's happened so far?</button>
                                </div>
                                <textarea name="prompt" placeholder="Describe your action or ask the DM..." id="chatbox" required><%= prompt || '' %></textarea>
                                <input type="hidden" name="conversationId" id="conversation-id" value="<%= conversationId || '' %>">
                            </div>
                            <button type="submit" id="submit-btn">
                                <img src="/icons/send.png" width="30" height="30">
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div id="combatCont" data-view="course">
            <div class="header">COURSE</div>
            <div class="attackCont">
                <div class="topCont">
                    <div class="encumCont" id="encumCont" data-current-weight="0">
                        <div class="contBan">
                            <div class="label">Level <%= level %></div>
                            <div class="weight" id="weightTxt"><%= XP %>/<%= MAXXP %> XP</div>
                        </div>
                        <progress class="encumBar" id="encumbar" value="<%= XP %>" max="<%= MAXXP %>"></progress>
                    </div>
                    <div class="categoryCont">
                        <button class="courseCate active" data-category='progress'>
                            Progress
                        </button>
                        <button class="courseCate" data-category='units'>
                            All Units
                        </button>
                    </div>
                    <div class="categorySelected">
                        <div class="currentPanelCate enabled" data-category="progress">
                            <% mastery.forEach((courseSet) => { %>
                                <% (courseSet.sections || []).forEach((section) => { %>
                                    <% if (section.current) { %>
                                        <div class="header"><%= section.name %></div>
                                        <div class="completionCont" style="margin-top: -10px;">
                                            <div class="fillCircle"
                                                role="progressbar"
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                                style="--progress: <%= section.completion %>%; --color: <%= section.color %>"></div>
                                            <div class="fillTxt"><%= section.completion %>%</div>
                                        </div>
                                        <div class="header">Milestones</div>
                                        <div class="sectionsKey mainPage milestone" style="width: 100%; margin-top: -10px;">
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">5%</div>
                                                    <div class="secName">Beginner</div>
                                                </div>
                                                <div class="secPercent">+500 XP</div>
                                            </div>
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">15%</div>
                                                    <div class="secName">Novice</div>
                                                </div>
                                                <div class="secPercent">+800 XP</div>
                                            </div>
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">30%</div>
                                                    <div class="secName">Apprentice</div>
                                                </div>
                                                <div class="secPercent">+1200 XP</div>
                                            </div>
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">50%</div>
                                                    <div class="secName">Experienced</div>
                                                </div>
                                                <div class="secPercent">+1700 XP</div>
                                            </div>
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">75%</div>
                                                    <div class="secName">Expert</div>
                                                </div>
                                                <div class="secPercent">+2300 XP</div>
                                            </div>
                                            <div class="section">
                                                <div class="secContLeft">
                                                    <div class="secPerc">100%</div>
                                                    <div class="secName">Completionist</div>
                                                </div>
                                                <div class="secPercent">+3000 XP</div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }); %>
                            <% }); %>
                        </div>
                        <div class="currentPanelCate disabled" data-category="units">
                            <button onclick="window.location.href='/mastery'" style="margin-top: 10px;">VIEW FULL MASTERY</button>
                            <div class="sectionsKey mainPage">
                                <% mastery.forEach((courseSet) => { %>
                                    <% (courseSet.sections || []).forEach((section, index) => { %>
                                        <div class="section" data-course-index="<%= index %>">
                                            <div class="secContLeft">
                                                <div class="secColor" style="--color: <%= section.color %>;"></div>
                                                <div class="secName"><%= section.name %>
                                                    <strong><%= (section.current ? ' (CURRENT)' : '') %></strong>
                                                </div>
                                            </div>
                                            <div class="secPercent"><%= section.completion %>%</div>
                                        </div>
                                    <% }); %>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bottomCont">
                    <div class="spellSlotsCont">
                    </div>
                    <div class="rollCont" id="roll">
                        <div class="diceRoller">
                            <div class="header">DICE ROLLER</div>
                            <div class="diceCont">
                                <button class="diceBtn" data-dice="4">d4</button>
                                <button class="diceBtn" data-dice="6">d6</button>
                                <button class="diceBtn" data-dice="8">d8</button>
                                <button class="diceBtn" data-dice="10">d10</button>
                                <button class="diceBtn" data-dice="12">d12</button>
                                <button class="diceBtn" data-dice="20">d20</button>
                            </div>
                            <div class="modCont">
                                <div class="mod">MOD</div>
                                <input type="number" class="modInput" id="modInput" value="0">
                            </div>
                        </div>
                        <div class="diceResultCont">
                            <div class="total" id="diceResult">2</div>
                            <div class="resultInfoCont">
                                <div class="rolled" id="rolled">d4</div>
                                <div class="plusRes" id="modResult" style="opacity: 0;">+2</div>
                            </div>
                            <div class="nat" id="nat" style="opacity: 0;">NAT 1</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="footer">
        <div class="nav">
            <div class="navIMG navIcon--inventory" onclick="viewMobilePage('inventory')"><img src="/icons/inventory.png" width="30" height="30"></div>
        </div>
        <div class="nav">
            <div class="navIMG navIcon--chat" onclick="viewMobilePage('chat')"><img src="/icons/chat.png" width="30" height="30"></div>
        </div>
        <div class="nav">
            <div class="navIMG navIcon--dice" onclick="viewMobilePage('dice')"><img src="/icons/dice.png" width="30" height="30"></div>
        </div>
        <div class="nav">
            <div class="navIMG navIcon--course" onclick="viewMobilePage('course')"><img src="/icons/course.png" width="30" height="30"></div>
        </div>
        <div class="nav">
            <div class="navIMG navIcon--settings" onclick="viewMobilePage('settings')"><img src="/icons/settings.png" width="30" height="30"></div>
        </div>
    </div>

    <script src="/chat.js"></script>
    <script>
        async function refreshAiStatus() {
            try {
                const response = await fetch('/api/ai-status');
                const data = await response.json();
                const dot = document.querySelector('.dot');
                const label = document.querySelector('.status h5');
                if (!dot || !label) return;
                const isOnline = response.ok && data.ready;
                dot.classList.toggle('online', isOnline);
                dot.classList.toggle('offline', !isOnline);
                label.textContent = isOnline ? 'AI Online' : 'AI Offline';
                label.classList.toggle('on', isOnline);
                label.classList.toggle('off', !isOnline);
            } catch (error) {
                const dot = document.querySelector('.dot');
                const label = document.querySelector('.status h5');
                if (dot) {
                    dot.classList.remove('online');
                    dot.classList.add('offline');
                }
                if (label) {
                    label.textContent = 'AI Offline';
                    label.classList.remove('on');
                    label.classList.add('off');
                }
            }
        }
        refreshAiStatus();

        // Simple client-side script to show loading text when submitted
        function showLoading() {
            document.getElementById('submit-btn').disabled = true;
            document.getElementById('submit-btn').innerHTML = '<span class="bounce">.</span><span class="bounce">.</span><span class="bounce">.</span>';
        }

        // Change theme
        function changeTheme(themeName) {
            document.documentElement.setAttribute('data-theme', themeName);
        }

        // Change mode
        function changeMode() {
            const attribute = document.documentElement.getAttribute('data-mode');
            if (attribute === 'default') {
                document.documentElement.setAttribute('data-mode', 'light');
            } else {
                document.documentElement.setAttribute('data-mode', 'default');
            }
        }

        // Hide inventory and Courses
        function hidePanels() {
            const inventory = document.getElementById("inventoryCont");
            const course = document.getElementById("combatCont");
            const currentlyHidden = inventory.style.display === "none" || course.style.display === "none";
            if (currentlyHidden) {
                inventory.style.display = "flex";
                course.style.display = "flex";
            } else {
                inventory.style.display = "none";
                course.style.display = "none";
            }
        }

        // Hide or show settings
        function viewSettings(hideorshow) {
            const settings = document.getElementById("settings");
            const chat = document.getElementById("chat");
            if (!settings) return;
            if (hideorshow) {
                settings.style.display = "none"; 
                chat.style.display = "flex";
            } else {
                settings.style.display = "flex"; 
                chat.style.display = "none";
            }
        }

        // Use pre-responses
        const preResponses = document.querySelectorAll('.preResponse');
        const chatbox = document.getElementById('chatbox');
        preResponses.forEach(button => {
            button.addEventListener('click', () => {
                chatbox.value = button.textContent.trim();
                chatbox.form.submit();
            });
        });

        // Update textbox
        const textarea = document.getElementById("origin");
        textarea.addEventListener("input", () => {
            textarea.style.height = "auto";
            textarea.style.height = textarea.scrollHeight + "px";
        });

        // FOR MOBILE: View the current page
        function hideAll() {
            const elements = [
                document.getElementById("inventoryCont"),
                document.getElementById("combatCont"),
                document.querySelector(".centerCont"),
                document.getElementById("settings"),
                document.getElementById("chat")
            ];

            elements.filter(Boolean).forEach(el => {
                el.style.display = "none";
            });
        }
        function viewMobilePage(page) {
            const key = page.toLowerCase();
            const sections = {
                inventory: document.getElementById("inventoryCont"),
                course: document.getElementById("combatCont"),
                dice: document.getElementById("combatCont"),
                settings: document.getElementById("settings"),
                chat: document.getElementById("chat")
            };
            const center = document.querySelector(".centerCont");
            hideAll();
            if (key === "settings" || key === "chat") {
                center.style.display = "flex";
            }
            if (sections[key]) {
                sections[key].style.display = "flex";
            }
            if (key === "course" || key === "dice") {
                sections[key].dataset.view = key;
            }
        }
    </script>
</body>
</html>
