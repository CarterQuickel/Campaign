<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Charma | Mastery</title>
    <link rel="icon" href="/icons/dndLogoPlaceholder.png">
    <link rel="stylesheet" href="/index.css">
    <link rel="stylesheet" href="/mastery.css">
</head>
<body class="fullMast">
    <div id="banner" class="masteryB">
        <div id="leftBan">
            <div id="title">
                <img src="/icons/CharmaLogo.png" width="200" height="200">
            </div>
        </div>
        <div id="rightBan">
            <button class="back" type="button" onclick="window.location.href='/'">
                <div id="desktopBack">BACK</div>
                <div id="mobileBack">RETURN TO MAIN PAGE</div>
            </button>
            <div class="horiz"></div>
            <div class="statCont">
                <div class="stat">
                    <div class="statType">LVL</div>
                    <div class="statNum" data-realtime-level><%= level %></div>
                </div>
                <div class="stat">
                    <div class="statType">PROF</div>
                    <div class="statNum">+<%= Math.floor(level / 4) + 2 %></div>
                </div>
                <div class="stat">
                    <div class="statType">AC</div>
                    <div class="statNum"><%= Math.floor((stats[1] - 10) / 2) + 10 %></div>
                </div>
            </div>
            <div class="horiz"></div>
            <% const statLabels = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA']; %>
            <div class="statCont">
                <% statLabels.forEach((label, index) => { %>
                    <div class="stat">
                        <div class="statType"><%= label %></div>
                        <div class="statNum"><%= stats[index] %></div>
                        <div class="statMod">
                            <% const mod = Math.floor((stats[index] - 10) / 2); %>
                            <%= mod >= 0 ? '+' : '' %><%= mod %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <div class="horiz"></div>
            <div class="stat">
                <div class="statType">HP</div>
                <div class="statNum" data-realtime-hp><%= playerHP %>/<%= charData.HP %></div>
            </div>
            <div class="horiz"></div>
            <div class="status">
                <div class="dot <%= online ? 'online' : 'offline' %>"></div>
                <% if (online) { %>
                    <h5 class="on">AI Online</h5>
                <% } else { %>
                    <h5 class="off">AI Offline</h5>
                <% } %>
            </div>
        </div>
    </div>
    <div id="SuperCont" class="pieWrap">
        <div class="courseHeaderRow courseHeaderBar">
            <div class="header courseTitleHeader">MASTERY COURSE</div>
            <div class="courseButtons">
                <% mastery.forEach((courseSet, buttonIndex) => { %>
                    <button type="button" class="courseBtn <%= buttonIndex === 0 ? 'active' : '' %>" data-group="<%= buttonIndex %>">
                        <%= courseSet.name %>
                    </button>
                <% }); %>
            </div>
        </div>
        <% mastery.forEach((courseSet, courseIndex) => { %>
            <% const sections = courseSet.sections || []; %>
            <% const courseAverage = Math.round(sections.reduce((total, section) => total + section.completion, 0) / sections.length); %>
            <div class="masteryCont course-group <%= courseIndex === 0 ? 'active' : '' %>" data-group="<%= courseIndex %>">
                <div class="pieParent" data-group="<%= courseIndex %>">
                    <% sections.forEach((section, sectionIndex) => { %>
                        <% const start = (sectionIndex / sections.length) * 100; %>
                        <% const end = ((sectionIndex + 1) / sections.length) * 100; %>
                        <div class="slice" data-course-index="<%= courseIndex %>" data-section-index="<%= sectionIndex %>" data-unit-id="<%= section.id %>" data-base-color="<%= section.color %>" style="--color: <%= section.color %>; --start: <%= start %>%; --end: <%= end %>%; --radius: <%= section.completion %>%;"></div>
                    <% }); %>
                    <div class="overallCont">
                        <div class="overallScore"><%= courseAverage %>%</div>
                    </div>
                </div>
                <div class="sectionsKey">
                    <% sections.forEach((section, index) => { %>
                        <div class="section mastery-unit" data-course-index="<%= courseIndex %>" data-section-index="<%= index %>" data-course-id="<%= courseSet.id %>" data-unit-id="<%= section.id %>" data-completion="<%= section.completion %>">
                            <div class="secContLeft">
                                <div class="secColor" style="--color: <%= section.color %>;"></div>
                                <div class="secName">
                                    <span class="secNameText"><%= section.name %> <strong class="mastery-current-mark"><%= section.current ? '(CURRENT)' : '' %></strong></span>
                                </div>
                            </div>
                            <div class="masteryUnitActions">
                                <div class="secPercent"><%= section.completion %>%</div>
                                <button type="button" class="setMasteryBtn" data-course-id="<%= courseSet.id %>" data-unit-id="<%= section.id %>" <%= section.current ? 'disabled' : '' %>>
                                    <%= section.current ? 'Current' : 'Make current' %>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% }); %>
    </div>
</body>
<script>
    const courseButtons = document.querySelectorAll('.courseBtn');
    const courseGroups = document.querySelectorAll('.course-group');

    courseButtons.forEach((button) => {
        button.addEventListener('click', () => {
            const targetGroup = Number(button.dataset.group);
            courseGroups.forEach((group, idx) => {
                const isActive = idx === targetGroup;
                group.classList.toggle('active', isActive);
                group.style.display = isActive ? 'flex' : 'none';
            });
            courseButtons.forEach((btn) => {
                btn.classList.toggle('active', Number(btn.dataset.group) === targetGroup);
            });
            courseGroups[targetGroup]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    });

    courseGroups.forEach((group, idx) => {
        group.style.display = idx === 0 ? 'flex' : 'none';
    });

    document.querySelectorAll('.section').forEach((section) => {
        const courseIndex = Number(section.dataset.courseIndex);
        const sectionIndex = Number(section.dataset.sectionIndex);

        section.addEventListener('mouseenter', () => {
            document.querySelectorAll(`.slice[data-course-index="${courseIndex}"][data-section-index="${sectionIndex}"]`).forEach((slice) => {
                slice.style.setProperty('--color', '#9F54DA');
            });
        });

        section.addEventListener('mouseleave', () => {
            document.querySelectorAll(`.slice[data-course-index="${courseIndex}"][data-section-index="${sectionIndex}"]`).forEach((slice) => {
                slice.style.setProperty('--color', slice.dataset.baseColor || '#ffffff');
            });
        });
    });

    document.querySelectorAll('.setMasteryBtn').forEach(button => {
        button.addEventListener('click', async () => {
            button.disabled = true;
            try {
                const response = await fetch('/api/course/mastery/current', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        courseId: button.dataset.courseId,
                        unitId: button.dataset.unitId
                    })
                });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Unable to change current mastery.');
                }

                document.querySelectorAll('.setMasteryBtn').forEach(otherButton => {
                    const isCurrent = Number(otherButton.dataset.courseId) === Number(result.courseId)
                        && Number(otherButton.dataset.unitId) === Number(result.unitId);
                    otherButton.disabled = isCurrent;
                    otherButton.textContent = isCurrent ? 'Current' : 'Make current';
                });
                document.querySelectorAll('.mastery-current-mark').forEach(mark => {
                    const unit = mark.closest('.mastery-unit');
                    const isCurrent = Number(unit?.dataset.courseId) === Number(result.courseId)
                        && Number(unit?.dataset.unitId) === Number(result.unitId);
                    mark.textContent = isCurrent ? '(CURRENT)' : '';
                });
                document.querySelectorAll('.course-group').forEach(group => {
                    const selectedUnit = group.querySelector(`.mastery-unit[data-course-id="${result.courseId}"][data-unit-id="${result.unitId}"]`);
                    if (selectedUnit) {
                        const groupIndex = group.dataset.group;
                        courseGroups.forEach((item, index) => {
                            const active = String(index) === groupIndex;
                            item.classList.toggle('active', active);
                            item.style.display = active ? 'flex' : 'none';
                            courseButtons[index]?.classList.toggle('active', active);
                        });
                        group.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            } catch (error) {
                console.error('Unable to set current mastery unit:', error);
                button.disabled = false;
                button.textContent = 'Try again';
            }
        });
    });
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/realtime.js"></script>
</html>