<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Charma Mastery</title>
    <link rel="stylesheet" href="/index.css">
    <link rel="stylesheet" href="/mastery.css">
</head>
<body>
    <div id="banner">
        <div id="leftBan">
            <div id="title">
                <img src="/icons/CharmaLogo.png" width="200" height="200">
            </div>
        </div>
        <div id="rightBan">
            <button class="new-conversation" type="button" onclick="window.location.href='/'">
                BACK
            </button>
            <div class="horiz"></div>
            <div class="statCont">
                <div class="stat">
                    <div class="statType">LVL</div>
                    <div class="statNum">3</div>
                </div>
                <div class="stat">
                    <div class="statType">PROF</div>
                    <div class="statNum">+2</div>
                </div>
                <div class="stat">
                    <div class="statType">AC</div>
                    <div class="statNum"><%= Math.floor((stats[1] - 10) / 2) + 10 %></div>
                </div>
            </div>
            <div class="horiz"></div>
            <% const statLabels = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA']; %>
            <div class="statCont">
                <% statLabels.forEach((label, index) => { %>
                    <div class="stat">
                        <div class="statType"><%= label %></div>
                        <div class="statNum"><%= stats[index] %></div>
                        <div class="statMod">
                            <% const mod = Math.floor((stats[index] - 10) / 2); %>
                            <%= mod >= 0 ? '+' : '' %><%= mod %>
                        </div>
                    </div>
                <% }); %>
            </div>
            <div class="horiz"></div>
            <div class="status">
                <div class="dot <%= online ? 'online' : 'offline' %>"></div>
                <% if (online) { %>
                    <h5 class="on">AI Online</h5>
                <% } else { %>
                    <h5 class="off">AI Offline</h5>
                <% } %>
            </div>
        </div>
    </div>
    <div id="SuperCont">
        <div class="masteryCont">
            <div class="pieParent">
                <div class="slice 1" style="--color: <%= mastery[0].color %>; --start: 16%; --end: 33%;  --radius: <%= mastery[0].completion %>%;"></div>
                <div class="slice 2" style="--color: <%= mastery[1].color %>; --start: 33%; --end: 50%;  --radius: <%= mastery[1].completion %>%;"></div>
                <div class="slice 3" style="--color: <%= mastery[2].color %>; --start: 50%; --end: 67%; --radius: <%= mastery[2].completion %>%;"></div>
                <div class="slice 4" style="--color: <%= mastery[3].color %>; --start: 67%; --end: 84%; --radius: <%= mastery[3].completion %>%;"></div>
                <div class="slice 5" style="--color: <%= mastery[4].color %>; --start: 84%; --end: 100%; --radius: <%= mastery[4].completion %>%;"></div>
                <div class="slice 6" style="--color: <%= mastery[5].color %>; --start: 0%; --end: 16%; --radius: <%= mastery[5].completion %>%;"></div>
                <div class="overallCont">
                    <div class="overallScore">
                        <%= Math.round((mastery[0].completion + mastery[1].completion + mastery[2].completion + mastery[3].completion + mastery[4].completion + mastery[5].completion) / 6) %>%
                    </div>
                </div>
            </div>
            <div class="header">MASTERY</div>
            <div class="sectionsKey">
                <% mastery.forEach((section, index) => { %>
                    <div class="section <%= index + 1 %>">
                        <div class="secContLeft">
                            <div class="secColor" style="--color: <%= section.color %>;"></div>
                            <div class="secName"><%= section.name %></div>
                        </div>
                        <div class="secPercent"><%= section.completion %>%</div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
</body>
<script>
    const slice = document.querySelectorAll('.slice');
    const courses = document.querySelectorAll('.section');
    slice.forEach(s => {
        s.dataset.baseColor = s.style.getPropertyValue('--color');
    });
    courses.forEach(e => {
        e.addEventListener('mouseenter', () => {
            slice.forEach(s => {
                if (e.classList[1] === s.classList[1]) {
                    s.style.setProperty('--color', '#9F54DA');
                }
            })
        });
        e.addEventListener('mouseleave', () => {
        slice.forEach(s => {
            if (e.classList[1] === s.classList[1]) {
                s.style.setProperty('--color', s.dataset.baseColor);
            }
        });
    });
    });
</script>
</html>